# ── 云端共享模式（推荐，平台常驻浏览器）──────────────
# 平台浏览器 CDP 端点；设置后网关直接连接，不自己启动浏览器
ZUJUAN_CDP_ENDPOINT=http://127.0.0.1:9222
# 下载文件保存目录
ZUJUAN_DOWNLOAD_DIR=/home/user/zujuan-downloads

# ── 网关（doubao/gateway.mjs）────────────────────────
# 网关监听端口（默认 8765，仅 127.0.0.1）
# ZUJUAN_GATEWAY_PORT=8765
# 可选：网关访问令牌；设置后请求需带 Authorization: Bearer <令牌>
# ZUJUAN_GATEWAY_TOKEN=

# ── 本地/自启浏览器模式（不使用共享 CDP 时）──────────
# 启动模式：cdp（默认）| playwright
# ZUJUAN_LAUNCH_MODE=cdp
# 是否无头：1/0
# ZUJUAN_HEADLESS=1
# 浏览器用户目录
# ZUJUAN_PROFILE_DIR=/home/user/.zujuan-mcp/profile
# 浏览器可执行文件路径（找不到时设置）
# ZUJUAN_CHROME_PATH=
# 容器环境追加参数：1/0
# ZUJUAN_CONTAINER=0

# ── 行为调节 ────────────────────────────────────────
# 两次导航最小间隔（毫秒），过快会触发滑块
# ZUJUAN_MIN_NAV_INTERVAL_MS=4000
# 人工安全验证最长等待秒数
# ZUJUAN_VERIFY_TIMEOUT_SEC=300
